# Server port
PORT=4000

# MongoDB connection (local default; use MongoDB Atlas for hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/bridge

# Secret used to sign session tokens (set a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# GoDaddy Personal Access Token (PAT) — used to verify domain ownership
# via the GoDaddy Domains v1 API (GET /v1/domains/{domain})
GODADDY_API_KEY=your-godaddy-pat

# OpenAI API key — powers AI pitch scoring (/api/pitch-score)
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini API key — alt AI provider for pitch scoring (used if set)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Email delivery — required for OTP emails (JS-generated codes sent via nodemailer)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<Gmail App Password>, FROM_EMAIL=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
